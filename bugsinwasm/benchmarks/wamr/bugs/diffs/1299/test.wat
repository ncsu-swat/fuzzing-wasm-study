cursor_x);\0a                    print_csi(l, \22D\22); /* left */\0a                    delta -= l;\0a                    term_cursor_x -= l;\0a                }\0a            }\0a        }\0a    }\0a\0a    function update() {\0a        var i;\0a\0a        if (cmd != last_cmd) {\0a            if (!show_colors && last_cmd.substring(0, last_cursor_pos) == cmd.substring(0, last_cursor_pos)) {\0a                /* optimize common case */\0a                std.puts(cmd.substring(last_cursor_pos));\0a            } else {\0a                /* goto the start of the line */\0a                move_cursor(-last_cursor_pos);\0a                if (show_colors) {\0a                    var str = mexpr ? mexpr + '\5cn' + cmd : cmd;\0a                    var start = str.length - cmd.length;\0a                    var colorstate = colorize_js(str);\0a                    print_color_text(str, start, colorstate[2]);\0a                } else {\0a                    std.puts(cmd);\0a                }\0a            }\0a            /* Note: assuming no surrogate pairs */\0a            term_cursor_x = (term_cursor_x + cmd.length) % term_width;\0a            if (term_cursor_x == 0) {\0a                /* show the cursor on the next line */\0a                std.puts(\22 \5cx08\22);\0a            }\0a            /* remove the trailing characters */\0a            std.puts(\22\5cx1b[J\22);\0a            last_cmd = cmd;\0a            last_cursor_pos = cmd.length;\0a        }\0a        move_cursor(cursor_pos - last_cursor_pos);\0a        last_cursor_pos = cursor_pos;\0a        std.out.flush();\0a    }\0a\0a    /* editing commands */\0a    function insert(str) {\0a        if (str) {\0a            cmd = cmd.substring(0, cursor_pos) + str + cmd.substring(cursor_pos);\0a            cursor_pos += str.length;\0a        }\0a    }\0a\0a    function quoted_insert() {\0a        quote_flag = true;\0a    }\0a\0a    function abort() {\0a        cmd = \22\22;\0a        cursor_pos = 0;\0a        return -2;\0a    }\0a\0a    function alert() {\0a    }\0a\0a    function beginning_of_line() {\0a        cursor_pos = 0;\0a    }\0a\0a    function end_of_line() {\0a        cursor_pos = cmd.length;\0a    }\0a\0a    function forward_char() {\0a        if (cursor_pos < cmd.length)\0a            cursor_pos++;\0a    }\0a\0a    function backward_char() {\0a        if (cursor_pos > 0)\0a            cursor_pos--;\0a    }\0a\0a    function skip_word_forward(pos) {\0a        while (pos < cmd.length && !is_word(cmd.charAt(pos)))\0a            pos++;\0a        while (pos < cmd.length && is_word(cmd.charAt(pos)))\0a            pos++;\0a        return pos;\0a    }\0a\0a    function skip_word_backward(pos) {\0a        while (pos > 0 && !is_word(cmd.charAt(pos - 1)))\0a            pos--;\0a        while (pos > 0 && is_word(cmd.charAt(pos - 1)))\0a            pos--;\0a        return pos;\0a    }\0a\0a    function forward_word() {\0a        cursor_pos = skip_word_forward(cursor_pos);\0a    }\0a\0a    function backward_word() {\0a        cursor_pos = skip_word_backward(cursor_pos);\0a    }        \0a\0a    function accept_line() {\0a        std.puts(\22\5cn\22);\0a        history_add(cmd);\0a        return -1;\0a    }\0a\0a    function history_add(str) {\0a        if (str) {\0a            history.push(str);\0a        }\0a        history_index = history.length;\0a    }\0a\0a    function previous_history() {\0a        if (history_index > 0) {\0a            if (history_index == history.length) {\0a                history.push(cmd);\0a            }\0a            history_index--;\0a            cmd = history[history_index];\0a            cursor_pos = cmd.length;\0a        }\0a    }\0a\0a    function next_history() {\0a        if (history_index < history.length - 1) {\0a            history_index++;\0a            cmd = history[history_index];\0a            cursor_pos = cmd.length;\0a        }\0a    }\0a\0a    function history_search(dir) {\0a        var pos = cursor_pos;\0a        for (var i = 1; i <= hist